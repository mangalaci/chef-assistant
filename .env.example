# Másold le .env néven, és töltsd ki a saját értékeiddel.
# A .env fájlt a .gitignore kizárja, nem kerül fel a GitHubra.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rag_starter
OPENAI_API_KEY=your_openai_api_key_here
# Chat modell. gpt-5-mini gyors (~2 mp); a gpt-5 jobb, de lassabb (~6 mp egy rövid válasz).
CHAT_MODEL=gpt-5-mini
# A gpt-5* modellek gondolkodási ideje: minimal | low | medium | high. A low kb. 3x gyorsabb a mediumnál.
REASONING_EFFORT=low
